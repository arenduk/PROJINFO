# Copie ce fichier en `secrets.toml` (a cote) et remplis les vraies valeurs.
# secrets.toml ne doit JAMAIS etre commit (voir .gitignore) - meme principe
# que .env / .env.exemple a la racine du projet.
#
# Ces valeurs viennent d'un client OAuth 2.0 cree sur Google Cloud Console
# (type "Application Web"). Voir le README pour les etapes detaillees.

[auth]
# En production : https://arenduk.fr/oauth2callback (chemin fixe, impose par Streamlit)
# En local :       http://localhost:8501/oauth2callback
redirect_uri = "https://arenduk.fr/oauth2callback"

# Genere avec : python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "change-moi"

client_id = "xxxxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Preselection du compte Google Workspace icam.fr dans l'ecran de connexion
# (confort uniquement : la vraie restriction de domaine est faite cote
# application dans app/auth.py, pas ici).
client_kwargs = { hd = "icam.fr" }
