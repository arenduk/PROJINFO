MYSQL_ROOT_PASSWORD=change-moi-vite
MYSQL_DATABASE=SAP_bis
MYSQL_USER=appuser
MYSQL_PASSWORD=change-moi-aussi

# Optionnel mais recommandé : seule cette adresse @icam.fr peut
# devenir administrateur lors du tout premier login (voir app/auth.py).
# Si elle est vide, le tout premier compte jamais cree devient admin
# Pratique en local, mais sur un domaine public, il faut metre sa propre
#  adresse ici pour ne pas laisser un tiers devenir admin.
BOOTSTRAP_ADMIN_EMAIL=
