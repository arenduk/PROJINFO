# Copie ce fichier en `.env` (a la racine) et mets de vrais mots de passe.
# .env ne doit jamais etre commit (voir .gitignore).

MYSQL_ROOT_PASSWORD=change-moi
MYSQL_DATABASE=SAP_bis
MYSQL_USER=appuser
MYSQL_PASSWORD=change-moi

# Optionnel mais recommande en production : seule cette adresse @icam.fr peut
# devenir administrateur lors du tout premier login (voir app/auth.py). Si
# elle est vide, le tout premier compte jamais cree devient admin - pratique
# en local, mais sur un domaine public, mets ta propre adresse ici pour ne
# pas laisser un tiers devenir admin avant toi.
BOOTSTRAP_ADMIN_EMAIL=
